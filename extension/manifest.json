{
  "manifest_version": 3,
  "name": "DayBrain — AI Memory Engine",
  "version": "0.2.1",
  "description": "Private local memory for your AI. Gives Claude and ChatGPT context about your workday — no cloud required.",
  "homepage_url": "https://kryptosai.github.io/daybrain/",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:19840/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DayBrain",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
